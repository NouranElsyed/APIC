// ============================================================================
// SteelFlow ERP — Prisma Schema
// Phase 1: Core Platform (Auth, RBAC, Projects, Customers, Documents, Reports)
//
// Phase 2 note: Pricing / Scrap / Cost Reconciliation models are intentionally
// NOT defined here. When Phase 2 begins, new models (e.g. Quotation,
// MaterialItem, ScrapEntry, CostComponent, PriceList) will attach to Project
// via a nullable/optional relation, so nothing in Phase 1 needs to change.
// See: src/features/phase2-pricing and src/features/phase2-scrap (stubs).
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum Role {
  ADMIN
  MANAGER
  ENGINEER
  VIEWER
}

enum ProjectStage {
  TENDERING
  EXECUTION
}

enum ProjectStatus {
  // Tendering stage statuses
  UNDER_STUDY
  SUBMITTED
  APOLOGIZED
  CANCELLED
  // Execution stage statuses
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum DocumentCategory {
  DRAWING
  SPECIFICATION
  CONTRACT
  PURCHASE_ORDER
  TECHNICAL_DOCUMENT
  EMAIL
  OTHER
}

enum MeetingStatus {
  SCHEDULED
  HELD
  CANCELLED
  POSTPONED
}

// ----------------------------------------------------------------------------
// Core Models
// ----------------------------------------------------------------------------

model User {
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  password   String // bcrypt hash
  role       Role     @default(VIEWER)
  department String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  createdProjects  Project[]  @relation("ProjectCreatedBy")
  uploadedDocs     Document[] @relation("DocumentUploadedBy")
  activityLogs     ActivityLog[]
  scopeItems       ScopeItem[]     @relation("ScopeItemCreatedBy")
  notices          Notice[]        @relation("NoticeCreatedBy")
  meetingMinutes   MeetingMinute[] @relation("MeetingMinuteCreatedBy")
  uploadedDxfFiles PartDxf[]       @relation("PartDxfUploadedBy")
  createdNestingJobs NestingJob[]  @relation("NestingJobCreatedBy")
  createdNestingRuns NestingRun[]  @relation("NestingRunCreatedBy")

  @@map("users")
}

model Customer {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  contact   String?
  email     String?
  phone     String?
  address   String?
  taxNumber String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]

  @@map("customers")
}

model Project {
  id          String        @id @default(cuid())
  number      String        @unique
  name        String
  description String?
  stage       ProjectStage  @default(TENDERING)
  status      ProjectStatus @default(UNDER_STUDY)
  revision    String        @default("Rev. 00")
  dueDate     DateTime?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  createdById String
  createdBy   User   @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  documents Document[]
  takeoffDrawings TakeoffDrawing[]
  scopeItems      ScopeItem[]
  notices         Notice[]
  meetingMinutes  MeetingMinute[]
  nestingJobs     NestingJob[]

  // ---------------------------------------------------------------------
  // Phase 2 extension point (do not remove): future models such as
  // Quotation, MaterialUsage, ScrapEntry, CostSummary will each declare
  // `projectId` and relate back here. No change to Project is required.
  // ---------------------------------------------------------------------

  @@map("projects")
}

// ----------------------------------------------------------------------------
// Material Take-Off — Area & Weight (Phase 2, stage 1)
// Mirrors the "Riser Duct Fabrication Drg" calculation sheet:
//   unitArea (ext) = extWidth * extLength * 2   (both sides)
//   unitArea (int) = intWidth * intLength * 2   (both sides)
//   totalUnitArea  = extUnitArea + intUnitArea
//   totalArea      = totalUnitArea * qty
//   volume         = (totalArea / 2) * thicknessMm
//   weight (kg)    = volume * 7.85
// ----------------------------------------------------------------------------
model TakeoffDrawing {
  id            String   @id @default(cuid())
  drawingNumber String // e.g. "13334036"
  title         String // e.g. "Existing Riser Ø4657"
  weightFromDwg Float? // reference weight from the drawing itself, for variance check
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  parts TakeoffPart[]

  @@map("takeoff_drawings")
}

model TakeoffPart {
  id          String  @id @default(cuid())
  itemNo      Int
  description String // e.g. "PL 20 mm", "IPE 120", free text label

  // Per-part material (e.g. "Steel", "Stainless Steel"). Optional because
  // existing rows predate this field. This is the authoritative source of
  // material for DXF Nesting grouping — never NestingJob.material, which is
  // legacy job-level metadata only (see NestingJob doc comment below).
  material String?

  // What kind of item this is — drives which fields are relevant and what
  // the default area/weight formula looks like:
  //   PLATE      — flat sheet: width x length x thickness, optional cut-out
  //   HOT_ROLLED — rolled section (IPE/FB/angle/etc): weight is per-metre
  //                of the profile, not area x thickness x density
  //   CONE       — frustum shell: D1, D2, height, thickness
  //   PIPE       — cylindrical shell: OD, wall thickness, length
  partType PartType

  // Internal vs external scope item (e.g. duct inner wall vs outer wall).
  // Purely descriptive/filterable — does not affect the calculation.
  side PartSide @default(EXTERNAL)

  qty         Int
  thicknessMm Float? // required for PLATE/CONE/PIPE, irrelevant for HOT_ROLLED

  // Raw, type-specific inputs the user typed in the "Add Item" popup —
  // kept as JSON so each partType can have its own shape without a schema
  // migration per field. Populated by the client-side default-formula
  // builder in src/server/calc/takeoff.ts (`buildDefaultGeometryFormula`).
  //   PLATE:      { width, length, cutoffFormula? }
  //   CONE:       { d1, d2, height }
  //   PIPE:       { od, length }
  //   HOT_ROLLED: { profile, length, weightPerMeter, paintAreaPerMeter? }
  geometry Json

  // The area formula actually used to compute totalArea for sheet-based
  // types (PLATE/CONE/PIPE) — pre-filled from `geometry` with a sensible
  // default (e.g. "width*length" for a plate) but always visible and
  // editable by the user, Excel-style. Not used for HOT_ROLLED, whose
  // weight comes directly from weightPerMeter x length.
  areaFormula String?

  // Painting area is independent of the weight calculation: same geometry,
  // but the user chooses whether painting covers 1 face or 2 faces.
  paintSides Int @default(2) // 1 or 2

  // Stored (computed) results — recalculated server-side on every write
  // so they always match geometry/areaFormula without relying on the client.
  totalArea    Float // m2 — single-face net area (already includes any cut-out)
  volume       Float // totalArea * thicknessMm (sheet-based only, else 0)
  weightKg     Float
  paintAreaSqm Float @default(0) // totalArea * paintSides (sheet-based) — for HOT_ROLLED, paintAreaPerMeter * length * qty

  // Scrap tracking: buyWeightKg is the actual purchased/allocated stock
  // weight for this row (manual entry). scrapKg/scrapPct are derived and
  // only present once buyWeightKg is set.
  buyWeightKg Float? // kg — weight of stock material purchased for this row
  scrapKg     Float? // buyWeightKg - weightKg
  scrapPct    Float? // scrapKg / buyWeightKg

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  drawingId String
  drawing   TakeoffDrawing @relation(fields: [drawingId], references: [id], onDelete: Cascade)

  // Optional DXF Nesting extension (Phase 1) — a TakeoffPart works exactly
  // as before whether or not these are ever populated.
  dxf             PartDxf?
  nestingJobItems NestingJobItem[]
  // Phase 2A: historical placements referencing this part across nesting
  // runs. onDelete: Restrict on the placement side — see NestingPlacement.
  nestingPlacements NestingPlacement[] @relation("TakeoffPartNestingPlacements")

  @@map("takeoff_parts")
}

enum PartType {
  PLATE
  HOT_ROLLED
  CONE
  PIPE
}

enum PartSide {
  INTERNAL
  EXTERNAL
}

// ----------------------------------------------------------------------------
// DXF Nesting (Phase 1 — foundation only, no optimization engine yet)
//
// This is an ADDITIONAL, optional workflow layered on top of the existing
// Standard Calculations (TakeoffPart) system above. Nothing above this
// section changes. A TakeoffPart works exactly as before whether or not it
// ever gets a PartDxf attached.
//
//   TakeoffPart --(0..1)--> PartDxf            (actual uploaded geometry)
//   Project     --(0..*)--> NestingJob          (a batch of parts to nest)
//   NestingJob  --(0..*)--> NestingJobItem --> TakeoffPart (reference only,
//                                               never a duplicate/copy)
// ----------------------------------------------------------------------------

// The parsed, normalized result of a DXF upload for one TakeoffPart.
// One-to-one and fully optional — existing/older TakeoffPart rows simply
// have no PartDxf row at all.
model PartDxf {
  id String @id @default(cuid())

  fileName String
  filePath String
  fileSize Int?

  valid        Boolean @default(false)
  errorMessage String? // human-readable reason when valid = false

  // Detected/declared DXF units ($INSUNITS), reported as-is for transparency
  // — all derived numeric fields below are already normalized to mm / m².
  unitsDetected String?

  areaSqm      Float? // actual net geometry area (outer − holes), not bbox
  bboxWidthMm  Float?
  bboxHeightMm Float?

  outerContourCount Int? // should be exactly 1 for a valid single-part DXF
  holeCount         Int? @default(0)

  // Set when the bounding box looks implausible for the detected unit
  // (e.g. a part coming out several metres across) — usually means
  // $INSUNITS in the source file doesn't match how it was actually drawn.
  // Null when the size looks sane. Purely advisory, never blocks upload.
  unitsWarning String?

  // Normalized outer contour + hole contours (arrays of {x,y} in mm), kept
  // as JSON so the future nesting engine has the real shape to work with —
  // never re-derived from the bounding box.
  geometryJson Json?

  uploadedAt DateTime @default(now())

  takeoffPartId String      @unique
  takeoffPart   TakeoffPart @relation(fields: [takeoffPartId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation("PartDxfUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@map("part_dxf_files")
}

enum NestingJobStatus {
  DRAFT // still being assembled — parts can be added/removed
  READY // locked in, waiting for the (future) nesting/optimization engine
}

// A batch of nestable parts sharing a material + thickness, scoped to a
// Project — the container the future placement/optimization engine will
// eventually run against. Phase 1 only supports creating the job and
// assigning parts to it.
model NestingJob {
  id   String @id @default(cuid())
  name String
  // ⚠️ Legacy, optional job-level metadata only — kept for backward
  // compatibility with old records. NOT the source of truth for any part's
  // material/thickness. Nesting Groups / Source Coverage always resolve
  // material and thickness per TakeoffPart (see getEligibleNestingParts in
  // nesting.service.ts). Never read these two fields for grouping.
  material    String?
  thicknessMm Float?
  status      NestingJobStatus @default(DRAFT)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("NestingJobCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  items   NestingJobItem[] // superseded, see model doc comment — kept for compatibility, unused
  sources NestingSource[]
  runs    NestingRun[]

  @@map("nesting_jobs")
}

// A reference, never a copy — qtyOverride only exists for the (optional)
// case where fewer than the full TakeoffPart quantity should go into this
// specific nesting run; description/thickness/material stay owned by the
// TakeoffPart.
//
// ⚠️ Superseded (kept for backward compatibility only): eligible parts are
// now collected automatically per-project (see getEligibleNestingParts in
// nesting.service.ts) instead of being manually added one by one. This
// table and its API routes are no longer written to by the app — it's left
// in place, untouched and unused, so no data is lost and nothing has to be
// dropped from the database. A future reproducibility/snapshot model can
// reuse or replace it when the real nesting engine ships.
model NestingJobItem {
  id          String   @id @default(cuid())
  qtyOverride Int? // null = use the full TakeoffPart.qty
  createdAt   DateTime @default(now())

  nestingJobId String
  nestingJob   NestingJob @relation(fields: [nestingJobId], references: [id], onDelete: Cascade)

  takeoffPartId String
  takeoffPart   TakeoffPart @relation(fields: [takeoffPartId], references: [id], onDelete: Cascade)

  @@unique([nestingJobId, takeoffPartId])
  @@map("nesting_job_items")
}

// User-declared available source sheets for a Nesting Job — the one piece
// of information Phase 1b genuinely needs manual input for. Parts are
// collected automatically; source material is not (the system has no way
// to know what stock is available).
model NestingSource {
  id          String @id @default(cuid())
  material    String
  thicknessMm Float
  widthMm     Float
  lengthMm    Float

  // ⚠️ Legacy/informational only (PROJECT.md §2/§4): a Source Sheet
  // represents a purchasable material/thickness/size, NOT a fixed
  // inventory count. The nesting engine (nesting-engine.ts) NEVER reads
  // this field and NEVER caps how many sheets it opens because of it —
  // supply is always treated as unlimited to purchase. This column is kept
  // nullable, for backward compatibility with older records and in case a
  // future stock-tracking feature wants a distinct "sheets already on
  // hand" number; the actual "how many do I need to buy" answer always
  // comes from NestingRun.sourceRequirementJson, calculated after a run.
  availableQty Int?
  createdAt    DateTime @default(now())

  nestingJobId String
  nestingJob   NestingJob @relation(fields: [nestingJobId], references: [id], onDelete: Cascade)

  // Phase 2A: NestingSheet rows created by a future run may point back here
  // for provenance, but always snapshot material/thickness/width/length at
  // creation time — this record can keep changing after that without ever
  // affecting an already-completed NestingRun. See NestingSheet doc comment.
  nestingSheets NestingSheet[]

  @@map("nesting_sources")
}

// ----------------------------------------------------------------------------
// Nesting Run persistence (Phase 2 — real engine, see nesting-engine.ts /
// nesting-run.service.ts)
//
// A NestingRun is one execution of the deterministic shelf-fit algorithm in
// src/server/calc/nesting-engine.ts, persisted here by
// src/server/services/nesting-run.service.ts. No packing/rotation logic
// lives in this schema file — this only defines the shape results are
// written into.
//
//   NestingJob --(0..*)--> NestingRun  (one execution of the engine)
//   NestingRun --(0..*)--> NestingSheet    (one physical sheet used by that run)
//   NestingSheet --(0..*)--> NestingPlacement (one placed piece on that sheet)
//   NestingPlacement --(1)--> TakeoffPart      (reference only, never a copy)
//
// Coordinate convention (applies to NestingPlacement.xMm/yMm/rotationDeg):
//   - all lengths in millimeters, never pixels or percentages
//   - sheet origin (0,0) = bottom-left corner of the sheet
//   - x increases to the right, y increases upward
//   - xMm/yMm is the placement's origin/anchor point on the sheet
//   - rotationDeg is measured counter-clockwise from 0; stored as a plain
//     Float so a future engine is free to use 0/90 only at first and later
//     support 180/270 or arbitrary angles without a schema change
//
// Reproducibility: once a run is COMPLETED, later edits to NestingSource,
// TakeoffPart, or Standard Calculations must NOT change that run's stored
// results. NestingSheet therefore snapshots material/thickness/width/length
// at creation time instead of reading them live off NestingSource.
// NestingPlacement still references the live TakeoffPart (geometry keeps
// coming from TakeoffPart -> PartDxf -> geometryJson) — full part-geometry
// snapshotting is explicitly out of scope for this phase; see report.
// ----------------------------------------------------------------------------

enum NestingRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

// One execution of the (future) nesting engine for a NestingJob. Historical
// record — a job can accumulate many runs over time (re-runs, what-ifs).
model NestingRun {
  id     String           @id @default(cuid())
  status NestingRunStatus @default(PENDING)

  // Which algorithm produced this run and with what settings — recorded so
  // historical runs stay interpretable even after the engine evolves.
  algorithmName    String?
  algorithmVersion String?
  configJson       Json? // full EngineConfig snapshot, e.g. { marginLeftMm, marginRightMm, marginTopMm, marginBottomMm, partGapMm }

  // Denormalized copies of the same values inside configJson (PROJECT.md
  // §13/§20) so a run's parameters can be queried/displayed without parsing
  // JSON. configJson remains the authoritative snapshot; these are for
  // convenience only.
  partGapMm      Float?
  marginLeftMm   Float?
  marginRightMm  Float?
  marginTopMm    Float?
  marginBottomMm Float?

  // Automatically-calculated purchasing requirement (PROJECT.md §3/§16):
  // one row per source sheet definition used by this run, e.g.
  // [{ sourceSheetId, material, thicknessMm, widthMm, lengthMm, requiredQty }].
  // Never populated from user input — always derived by the engine.
  sourceRequirementJson Json?

  createdAt    DateTime  @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  errorMessage String?

  // Aggregate metrics — always nullable in Phase 2A; the future engine
  // populates them once it actually computes a result. Not calculated here.
  totalSheets               Int?
  totalUsedAreaSqm          Float?
  totalScrapAreaSqm         Float?
  overallUtilizationPercent Float?

  // Part-count summary and the full unplaced-parts breakdown (part id,
  // requested/placed/remaining qty, reason) — kept as JSON since this is a
  // point-in-time report attached to the run, not a queryable relation.
  totalPartsRequired Int?
  totalPartsPlaced   Int?
  totalPartsUnplaced Int?
  unplacedPartsJson  Json?

  nestingJobId String
  nestingJob   NestingJob @relation(fields: [nestingJobId], references: [id], onDelete: Cascade)

  // Nullable + SetNull: losing the user who kicked off a run must never
  // delete historical nesting results, matching the PartDxf.uploadedBy /
  // NestingJob.createdBy pattern used elsewhere (Restrict there because
  // those relations are required; this one is optional).
  createdById String?
  createdBy   User?   @relation("NestingRunCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  sheets     NestingSheet[]
  placements NestingPlacement[]

  @@index([nestingJobId])
  @@index([status])
  @@map("nesting_runs")
}

// One physical source sheet actually used within a NestingRun. Dimensions
// and material are a SNAPSHOT of the NestingSource used, copied at creation
// time — never re-read live — so editing/deleting the source later cannot
// change a historical run's stored sheet metadata.
model NestingSheet {
  id String @id @default(cuid())

  sheetNumber Int // 1-based, unique within its run

  // Snapshot fields — copied from NestingSource at creation time.
  material    String
  thicknessMm Float
  widthMm     Float
  lengthMm    Float

  // Calculated metrics — nullable until the future engine computes them.
  usedAreaSqm        Float?
  scrapAreaSqm       Float?
  utilizationPercent Float?

  createdAt DateTime @default(now())

  nestingRunId String
  nestingRun   NestingRun @relation(fields: [nestingRunId], references: [id], onDelete: Cascade)

  // Provenance only — optional and SetNull on delete, since this sheet's
  // own material/thicknessMm/widthMm/lengthMm above are already a durable
  // snapshot and don't depend on this relation surviving.
  sourceSheetId String?
  sourceSheet   NestingSource? @relation(fields: [sourceSheetId], references: [id], onDelete: SetNull)

  placements NestingPlacement[]

  @@unique([nestingRunId, sheetNumber])
  @@index([nestingRunId])
  @@map("nesting_sheets")
}

// One placed instance of a TakeoffPart on a NestingSheet. A TakeoffPart with
// qty = 20 can end up with 20 NestingPlacement rows spread across multiple
// sheets/runs — instanceNumber (1..qty) identifies which required piece this
// is; it is never used to create duplicate TakeoffPart rows.
model NestingPlacement {
  id String @id @default(cuid())

  instanceNumber Int // 1-based index within (nestingRunId, takeoffPartId)

  // Millimeters, sheet-local, bottom-left origin — see model group doc
  // comment above for the full coordinate convention.
  xMm         Float
  yMm         Float
  rotationDeg Float @default(0)

  createdAt DateTime @default(now())

  nestingSheetId String
  nestingSheet   NestingSheet @relation(fields: [nestingSheetId], references: [id], onDelete: Cascade)

  // Denormalized alongside nestingSheetId so uniqueness can be enforced per
  // (run, part, instance) rather than per (sheet, part, instance) — the same
  // required instance must never be placeable twice within one run, even if
  // it ends up assigned to a different sheet than a sibling instance.
  nestingRunId String
  nestingRun   NestingRun @relation(fields: [nestingRunId], references: [id], onDelete: Cascade)

  // Reference only — the authoritative part data (number, description,
  // material, thickness, qty, DXF/geometryJson) stays owned by TakeoffPart,
  // never duplicated here. Restrict: a TakeoffPart that has ever been placed
  // in a nesting run cannot be deleted out from under historical results;
  // the app must resolve/clear those placements first.
  takeoffPartId String
  takeoffPart   TakeoffPart @relation("TakeoffPartNestingPlacements", fields: [takeoffPartId], references: [id], onDelete: Restrict)

  @@unique([nestingRunId, takeoffPartId, instanceNumber])
  @@index([nestingSheetId])
  @@index([takeoffPartId])
  @@map("nesting_placements")
}

model Document {
  id         String           @id @default(cuid())
  title      String
  category   DocumentCategory @default(OTHER)
  revision   String           @default("Rev. 00")
  filePath   String
  fileName   String
  fileSize   Int?
  uploadDate DateTime         @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@map("documents")
}

// Scope of work — a running list of scope entries for a project (not files).
model ScopeItem {
  id          String   @id @default(cuid())
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("ScopeItemCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@map("scope_items")
}

// Notices — a running list of notice entries for a project (not files).
model Notice {
  id          String   @id @default(cuid())
  title       String
  description String?
  noticeDate  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("NoticeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@map("notices")
}

// Meeting minutes — each entry is a meeting date + its status (not a file).
model MeetingMinute {
  id          String        @id @default(cuid())
  meetingDate DateTime
  status      MeetingStatus @default(SCHEDULED)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("MeetingMinuteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@map("meeting_minutes")
}

model ActivityLog {
  id        String   @id @default(cuid())
  action    String // e.g. "CREATE", "UPDATE", "DELETE", "LOGIN"
  entity    String // e.g. "PROJECT", "CUSTOMER", "DOCUMENT", "USER"
  entityId  String?
  detail    String?
  timestamp DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("activity_logs")
}

// ----------------------------------------------------------------------------
// Settings (single-row configuration table, admin managed)
// ----------------------------------------------------------------------------

model CompanySettings {
  id      Int    @id @default(1)
  name    String @default("SteelFlow Engineering Co.")
  logoUrl String?
  address String?
  phone   String?
  email   String?
  timezone String @default("Africa/Cairo")

  language           String  @default("en")
  dateFormat         String  @default("DD/MM/YYYY")
  currency           String  @default("EGP")
  theme              String  @default("light")

  defaultRevisionFormat String  @default("Rev. 00")
  autoSave              Boolean @default(true)

  updatedAt DateTime @updatedAt

  @@map("company_settings")
}

model ProjectStatusConfig {
  id        String        @id @default(cuid())
  status    ProjectStatus @unique
  label     String
  color     String        @default("gray")
  isDefault Boolean       @default(false)
  sortOrder Int           @default(0)

  @@map("project_status_config")
}
