// ============================================================================
// SteelFlow ERP — Prisma Schema
// Phase 1: Core Platform (Auth, RBAC, Projects, Customers, Documents, Reports)
//
// Phase 2 note: Pricing / Scrap / Cost Reconciliation models are intentionally
// NOT defined here. When Phase 2 begins, new models (e.g. Quotation,
// MaterialItem, ScrapEntry, CostComponent, PriceList) will attach to Project
// via a nullable/optional relation, so nothing in Phase 1 needs to change.
// See: src/features/phase2-pricing and src/features/phase2-scrap (stubs).
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum Role {
  ADMIN
  MANAGER
  ENGINEER
  VIEWER
}

enum ProjectStage {
  TENDERING
  EXECUTION
}

enum ProjectStatus {
  // Tendering stage statuses
  UNDER_STUDY
  SUBMITTED
  APOLOGIZED
  CANCELLED
  // Execution stage statuses
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum DocumentCategory {
  DRAWING
  SPECIFICATION
  CONTRACT
  PURCHASE_ORDER
  TECHNICAL_DOCUMENT
  EMAIL
  OTHER
}

enum MeetingStatus {
  SCHEDULED
  HELD
  CANCELLED
  POSTPONED
}

// ----------------------------------------------------------------------------
// Core Models
// ----------------------------------------------------------------------------

model User {
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  password   String // bcrypt hash
  role       Role     @default(VIEWER)
  department String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  createdProjects  Project[]  @relation("ProjectCreatedBy")
  uploadedDocs     Document[] @relation("DocumentUploadedBy")
  activityLogs     ActivityLog[]
  scopeItems       ScopeItem[]     @relation("ScopeItemCreatedBy")
  notices          Notice[]        @relation("NoticeCreatedBy")
  meetingMinutes   MeetingMinute[] @relation("MeetingMinuteCreatedBy")

  @@map("users")
}

model Customer {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  contact   String?
  email     String?
  phone     String?
  address   String?
  taxNumber String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]

  @@map("customers")
}

model Project {
  id          String        @id @default(cuid())
  number      String        @unique
  name        String
  description String?
  stage       ProjectStage  @default(TENDERING)
  status      ProjectStatus @default(UNDER_STUDY)
  revision    String        @default("Rev. 00")
  dueDate     DateTime?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  createdById String
  createdBy   User   @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  documents Document[]
  takeoffDrawings TakeoffDrawing[]
  scopeItems      ScopeItem[]
  notices         Notice[]
  meetingMinutes  MeetingMinute[]

  // ---------------------------------------------------------------------
  // Phase 2 extension point (do not remove): future models such as
  // Quotation, MaterialUsage, ScrapEntry, CostSummary will each declare
  // `projectId` and relate back here. No change to Project is required.
  // ---------------------------------------------------------------------

  @@map("projects")
}

// ----------------------------------------------------------------------------
// Material Take-Off — Area & Weight (Phase 2, stage 1)
// Mirrors the "Riser Duct Fabrication Drg" calculation sheet:
//   unitArea (ext) = extWidth * extLength * 2   (both sides)
//   unitArea (int) = intWidth * intLength * 2   (both sides)
//   totalUnitArea  = extUnitArea + intUnitArea
//   totalArea      = totalUnitArea * qty
//   volume         = (totalArea / 2) * thicknessMm
//   weight (kg)    = volume * 7.85
// ----------------------------------------------------------------------------
model TakeoffDrawing {
  id            String   @id @default(cuid())
  drawingNumber String // e.g. "13334036"
  title         String // e.g. "Existing Riser Ø4657"
  weightFromDwg Float? // reference weight from the drawing itself, for variance check
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  parts TakeoffPart[]

  @@map("takeoff_drawings")
}

model TakeoffPart {
  id          String  @id @default(cuid())
  itemNo      Int
  description String // e.g. "PL 20 mm", "IPE 120", free text label

  // What kind of item this is — drives which fields are relevant and what
  // the default area/weight formula looks like:
  //   PLATE      — flat sheet: width x length x thickness, optional cut-out
  //   HOT_ROLLED — rolled section (IPE/FB/angle/etc): weight is per-metre
  //                of the profile, not area x thickness x density
  //   CONE       — frustum shell: D1, D2, height, thickness
  //   PIPE       — cylindrical shell: OD, wall thickness, length
  partType PartType

  // Internal vs external scope item (e.g. duct inner wall vs outer wall).
  // Purely descriptive/filterable — does not affect the calculation.
  side PartSide @default(EXTERNAL)

  qty         Int
  thicknessMm Float? // required for PLATE/CONE/PIPE, irrelevant for HOT_ROLLED

  // Raw, type-specific inputs the user typed in the "Add Item" popup —
  // kept as JSON so each partType can have its own shape without a schema
  // migration per field. Populated by the client-side default-formula
  // builder in src/server/calc/takeoff.ts (`buildDefaultGeometryFormula`).
  //   PLATE:      { width, length, cutoffFormula? }
  //   CONE:       { d1, d2, height }
  //   PIPE:       { od, length }
  //   HOT_ROLLED: { profile, length, weightPerMeter, paintAreaPerMeter? }
  geometry Json

  // The area formula actually used to compute totalArea for sheet-based
  // types (PLATE/CONE/PIPE) — pre-filled from `geometry` with a sensible
  // default (e.g. "width*length" for a plate) but always visible and
  // editable by the user, Excel-style. Not used for HOT_ROLLED, whose
  // weight comes directly from weightPerMeter x length.
  areaFormula String?

  // Painting area is independent of the weight calculation: same geometry,
  // but the user chooses whether painting covers 1 face or 2 faces.
  paintSides Int @default(2) // 1 or 2

  // Stored (computed) results — recalculated server-side on every write
  // so they always match geometry/areaFormula without relying on the client.
  totalArea    Float // m2 — single-face net area (already includes any cut-out)
  volume       Float // totalArea * thicknessMm (sheet-based only, else 0)
  weightKg     Float
  paintAreaSqm Float @default(0) // totalArea * paintSides (sheet-based) — for HOT_ROLLED, paintAreaPerMeter * length * qty

  // Scrap tracking: buyWeightKg is the actual purchased/allocated stock
  // weight for this row (manual entry). scrapKg/scrapPct are derived and
  // only present once buyWeightKg is set.
  buyWeightKg Float? // kg — weight of stock material purchased for this row
  scrapKg     Float? // buyWeightKg - weightKg
  scrapPct    Float? // scrapKg / buyWeightKg

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  drawingId String
  drawing   TakeoffDrawing @relation(fields: [drawingId], references: [id], onDelete: Cascade)

  @@map("takeoff_parts")
}

enum PartType {
  PLATE
  HOT_ROLLED
  CONE
  PIPE
}

enum PartSide {
  INTERNAL
  EXTERNAL
}

model Document {
  id         String           @id @default(cuid())
  title      String
  category   DocumentCategory @default(OTHER)
  revision   String           @default("Rev. 00")
  filePath   String
  fileName   String
  fileSize   Int?
  uploadDate DateTime         @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@map("documents")
}

// Scope of work — a running list of scope entries for a project (not files).
model ScopeItem {
  id          String   @id @default(cuid())
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("ScopeItemCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@map("scope_items")
}

// Notices — a running list of notice entries for a project (not files).
model Notice {
  id          String   @id @default(cuid())
  title       String
  description String?
  noticeDate  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("NoticeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@map("notices")
}

// Meeting minutes — each entry is a meeting date + its status (not a file).
model MeetingMinute {
  id          String        @id @default(cuid())
  meetingDate DateTime
  status      MeetingStatus @default(SCHEDULED)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("MeetingMinuteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@map("meeting_minutes")
}

model ActivityLog {
  id        String   @id @default(cuid())
  action    String // e.g. "CREATE", "UPDATE", "DELETE", "LOGIN"
  entity    String // e.g. "PROJECT", "CUSTOMER", "DOCUMENT", "USER"
  entityId  String?
  detail    String?
  timestamp DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("activity_logs")
}

// ----------------------------------------------------------------------------
// Settings (single-row configuration table, admin managed)
// ----------------------------------------------------------------------------

model CompanySettings {
  id      Int    @id @default(1)
  name    String @default("SteelFlow Engineering Co.")
  logoUrl String?
  address String?
  phone   String?
  email   String?
  timezone String @default("Africa/Cairo")

  language           String  @default("en")
  dateFormat         String  @default("DD/MM/YYYY")
  currency           String  @default("EGP")
  theme              String  @default("light")

  defaultRevisionFormat String  @default("Rev. 00")
  autoSave              Boolean @default(true)

  updatedAt DateTime @updatedAt

  @@map("company_settings")
}

model ProjectStatusConfig {
  id        String        @id @default(cuid())
  status    ProjectStatus @unique
  label     String
  color     String        @default("gray")
  isDefault Boolean       @default(false)
  sortOrder Int           @default(0)

  @@map("project_status_config")
}
